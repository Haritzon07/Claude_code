# Denegar acceso directo a archivos de configuración
<Files "config.php">
    Order Allow,Deny
    Deny from all
</Files>

<Files "config.example.php">
    Order Allow,Deny
    Deny from all
</Files>

<Files "Database.php">
    Order Allow,Deny
    Deny from all
</Files>

<Files "funciones.php">
    Order Allow,Deny
    Deny from all
</Files>
